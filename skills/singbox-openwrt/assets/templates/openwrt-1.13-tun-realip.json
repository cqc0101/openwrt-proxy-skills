{
  "$schema": "https://raw.githubusercontent.com/SagerNet/sing-box/main/docs/configuration/schema.json",
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/tmp/sing-box-cache.db",
      "store_rdrc": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "",
      "default_mode": "Rule"
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "hosts",
        "type": "hosts"
      },
      {
        "tag": "local-dns",
        "type": "local"
      },
      {
        "tag": "google-dns",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "proxy"
      },
      {
        "tag": "alidns",
        "type": "udp",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "action": "route",
        "server": "hosts"
      },
      {
        "domain_suffix": [
          ".lan",
          ".local",
          ".home.arpa"
        ],
        "action": "route",
        "server": "local-dns"
      },
      {
        "query_type": [
          "PTR"
        ],
        "action": "route",
        "server": "local-dns"
      },
      {
        "rule_set": "geosite-ads",
        "action": "reject"
      },
      {
        "domain": [
          "use-application-dns.net",
          "mask.icloud.com",
          "mask-h2.icloud.com"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "local-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "google-dns"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "action": "route",
        "server": "alidns"
      }
    ],
    "final": "google-dns",
    "strategy": "ipv4_only",
    "reverse_mapping": true,
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": "172.19.0.1/30",
      "auto_route": true,
      "strict_route": false,
      "auto_redirect": false
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "direct",
        "US-Node"
      ],
      "default": "auto"
    },
    {
      "type": "selector",
      "tag": "ai",
      "outbounds": [
        "proxy",
        "US-Node"
      ]
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "US-Node"
      ],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "hysteria2",
      "tag": "US-Node",
      "server": "example.com",
      "server_port": 34589,
      "password": "PASSWORD",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "alidns",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "domain_suffix": [
          ".lan",
          ".local",
          ".home.arpa"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": "geosite-ads",
        "action": "reject"
      },
      {
        "domain": [
          "use-application-dns.net",
          "mask.icloud.com",
          "mask-h2.icloud.com"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-openai",
          "geosite-anthropic",
          "geosite-category-ai-chat-!cn"
        ],
        "action": "route",
        "outbound": "ai"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-telegram"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-ads",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-openai",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-openai.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-anthropic",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-anthropic.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ai-chat-!cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ai-chat-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-telegram",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-telegram.srs"
      }
    ],
    "final": "proxy"
  }
}
